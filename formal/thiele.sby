# SymbiYosys tasks for the extracted CPU and loader.
#
# Run through scripts/formal_prepare.py, which first writes the copies of the
# extracted Verilog that include the property files (build/formal/).
#
#   cpu_prove_pt    A3-A8 (partition table: 64-slot bound, empty slots above
#                   pt_next_id, ranges inside the 128-word memory, pairwise
#                   disjoint, partition traps go to the trap vector and leave
#                   the table unchanged, only PNEW/PSPLIT/PMERGE write it).
#   cpu_prove_ctrl  A1, A2, A9-A12 (err sticky, nothing executes after err,
#                   morphism-table bound and valid-below-next, mu written only
#                   by charging rules, halted cleared only by start).
#   sys_prove       S1-S5 (loader: start only while halted, no loads after
#                   start, start once, report only after a stop, one report).
#   Through formal_prepare.py, cpu_prove_pt uses cpu_partition_prove.py:
#   321 mandatory reset, frame, bounds/trap and pairwise induction obligations.
#   See partition-induction.txt for their composition and abstraction scope.
#   The direct sby cpu_prove_pt task below retains the original PDR alternative.
#   cpu_prove_ctrl uses abc pdr: an unbounded proof (IC3/PDR) over every state
#   reachable from reset, so no depth bounds what is covered; the multi-cycle
#   LASSERT, morphism-coupling and CHSH FSMs are inside that state space with
#   every phase and every interleaving with the method inputs.
#   sys_prove uses k-induction with proved auxiliary loader invariants.
#   Its depth of 4 bounds the induction search, not the execution covered:
#   both the reset base cases and the inductive step must pass.
#   cpu_cover, sys_cover: every assertion becomes an assumption and every
#   cover must be reached within 16 cycles from some state that satisfies all
#   of them (the CPU is never reset in these tasks). 16 cycles is more than
#   any single cover needs: each is an event of one or two cycles.
#   cpu_bmc_reset   (not in CI) bounded check from reset at depth 300: the
#   memory-clearing sweep after reset takes 256 cycles (module_tensors has 256
#   entries), then an instruction can be loaded and started, and the longest
#   FSM run (CHSH_LASSERT: dispatch, 29 phases, commit) takes 31 more.

[tasks]
cpu_prove_pt
cpu_prove_ctrl
cpu_cover
sys_prove
sys_cover
cpu_bmc_reset

[options]
cpu_prove_pt: mode prove
cpu_prove_ctrl: mode prove
sys_prove: mode prove
sys_prove: depth 4
cpu_cover: mode cover
cpu_cover: depth 16
sys_cover: mode cover
sys_cover: depth 16
cpu_bmc_reset: mode bmc
cpu_bmc_reset: depth 300

[engines]
# Expand SMT functions per frame for the memory-mapped coverage model.
# The depth, assumptions and coverage goals are unchanged.
cpu_prove_pt: abc pdr
cpu_prove_ctrl: abc pdr
sys_prove: smtbmc --unroll cvc5
cpu_cover: smtbmc --unroll cvc5
sys_cover: smtbmc --unroll cvc5
cpu_bmc_reset: smtbmc z3

[script]
verilog_defines -DBSV_NO_INITIAL_BLOCKS
cpu_prove_pt: verilog_defines -DF_SKIP_CTRL
cpu_prove_ctrl: verilog_defines -DF_SKIP_PT
cpu_cover: verilog_defines -DFORMAL_COVER
sys_cover: verilog_defines -DFORMAL_COVER
cpu_prove_pt: read -formal RegFile.v thiele_cpu_kami_props.v
cpu_prove_ctrl: read -formal RegFile.v thiele_cpu_kami_props.v
cpu_cover: read -formal RegFile.v thiele_cpu_kami_props.v
cpu_bmc_reset: read -formal RegFile.v thiele_cpu_kami_props.v
sys_prove: read -formal RegFile.v thiele_cpu_kami.v thiele_system_props.v
sys_cover: read -formal RegFile.v thiele_cpu_kami.v thiele_system_props.v
cpu_prove_pt: prep -flatten -top mkModule1
cpu_prove_ctrl: prep -flatten -top mkModule1
cpu_cover: prep -flatten -top mkModule1
cpu_bmc_reset: prep -flatten -top mkModule1
sys_prove: prep -flatten -top mkThieleSystem
sys_cover: prep -flatten -top mkThieleSystem
# Lower RAMs for every backend. The SMT array representation otherwise
# sees a cell-level loop when an asynchronous read feeds the same RAM write.
# This is the same state-preserving lowering already used by the prove tasks.
memory_map

[files]
../build/formal/RegFile.v
../build/formal/thiele_cpu_kami.v
../build/formal/thiele_cpu_kami_props.v
../build/formal/thiele_system_props.v
../build/formal/cpu_props.vh
../build/formal/system_props.vh
