-    bp_leb x z = true
-}.
-
-Definition bp_le {A} (P : BPre A) (x y : A) : Prop := bp_leb A P x y = true.
-
-Record amachine (A : Type) (P : BPre A) : Type := mk_am {
-  am_state : Type;
