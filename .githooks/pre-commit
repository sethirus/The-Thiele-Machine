#!/bin/sh
# Thiele Machine pre-commit hook (marker: thiele-machine-pre-commit)
# Installed with make install-hooks. Validates the proposed commit, regenerates
# derived artifacts, and runs the same strict pytest policy as CI. Full hardware
# synthesis/FPGA and cross-file vacuity verification still belong to CI (Full).
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Generators/tests read the working tree, while Git commits the index. Reject
# partial staging before any generator can overwrite or stage unrelated work.
python3 scripts/check_hook_worktree.py

for tool in coqc coqtop coq_makefile ocamlfind ocamlc iverilog vvp verilator yosys node; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "[pre-commit] FAIL: required tool missing: $tool" >&2
        exit 1
    fi
done

# Freshness tests must check our generated artifacts, not auto-repair them.
export CI=true

# Log failures without swallowing their diagnostics or continuing to stage
# partially generated output. Commands are argument lists, never eval strings.
run() {
    echo "[pre-commit] $*"
    if "$@"; then
        return 0
    else
        echo "[pre-commit] FAIL: $*" >&2
        exit 1
    fi
}

stage() {
    # Missing expected outputs are also generator failures.
    for file do
        if [ ! -f "$file" ]; then
            echo "[pre-commit] FAIL: missing generated file: $file" >&2
            exit 1
        fi
    done
    git add -- "$@"
}

run python3 -c '
import sys
sys.path.insert(0, "scripts")
from coq_proof_scope import validate_alignment
problems = validate_alignment()
if problems:
    sys.exit("[pre-commit] Coq proof-scope drift:\n" + "\n".join(problems))
'

# Incremental vendor builds must run even when Kami.vo already exists: it may
# be stale after a vendor change. Every build error blocks the commit.
run make -C vendor/bbv -j4
run bash scripts/fix_kami_coq18.sh
run make -C vendor/kami -j4
run sh -c 'cd coq && coq_makefile -f _CoqProject -o Makefile && make -j4'
# Extraction is a compiler side effect. A cached .vo alone cannot guarantee
# that its generated .ml still exists or matches; explicitly rerun entrypoints.
# Some entrypoints share Target output paths; serialize their side effects.
run make -C coq -j1 -W kami_hw/KamiExtraction.v -W Extraction.v -W ThieleMachineComplete.v \
    kami_hw/KamiExtraction.vo Extraction.vo ThieleMachineComplete.vo
stage build/kami_hw/Target.ml build/kami_hw/Target.mli \
    build/kami_hw/Target_complete.ml build/kami_hw/Target_complete.mli \
    build/thiele_core.ml build/thiele_core.mli \
    build/thiele_core_complete.ml build/thiele_core_complete.mli

# Refresh the assumption evidence when its inputs change. CI independently
# re-derives and compares it; it cannot be replaced by a manifest hash refresh.
if ! git diff --cached --quiet -- coq vendor scripts/coq_proof_scope.py \
        scripts/generate_assumption_receipt.sh scripts/run_assumption_batches.py \
        scripts/check_assumption_receipt.py build/probe/build_full_probe.py \
        build/probe/aggregate_full_probe.py artifacts/print_assumptions_all_proofs.json \
        artifacts/print_assumptions_all_proofs.txt artifacts/print_assumptions_all_proofs.csv; then
    run bash scripts/generate_assumption_receipt.sh
    stage coq/AssumptionsProbeAll.v artifacts/print_assumptions_all_proofs.json \
        artifacts/print_assumptions_all_proofs.txt build/probe/probe_inventory.json \
        build/probe/probe_all_output.txt build/probe/probe_all_err.txt build/probe/probe_batches.json
fi

# Re-probe staged target files; changing the target list or gate invalidates
# every verdict. CI (Full) also checks cross-file changes with a full sweep.
run python3 -c '
import json, subprocess
from pathlib import Path
staged = set(subprocess.check_output([
    "git", "diff", "--cached", "--name-only", "-z"
]).decode().split("\0"))
manifest = json.loads(Path("scripts/vacuity_targets.json").read_text())
args = []
if staged & {"scripts/vacuity_targets.json", "scripts/vacuity_gate.py"}:
    args = ["--manifest", "scripts/vacuity_targets.json"]
else:
    for target in manifest["targets"]:
        if target["path"] in staged:
            args += ["--target", target["path"], "--logical", target["logical"]]
    if args:
        args.append("--merge")
if args:
    subprocess.run(["python3", "scripts/vacuity_gate.py", *args,
                    "--output", "artifacts/vacuity_audit.json"], check=True)
summary = json.loads(Path("artifacts/vacuity_audit.json").read_text())["summary"]
if any(summary[key] for key in ("vacuous_true", "vacuous_hyp", "error")):
    raise SystemExit("[pre-commit] FAIL: vacuity audit: " + str(summary))
'
stage artifacts/vacuity_audit.json

run python3 scripts/forge_vm.py --input build/thiele_core.ml --output thielecpu/vm.py
stage thielecpu/vm.py
# Match CI: link the runner from the refreshed extraction before testing it.
run ocamlfind ocamlc -I build -package str -linkpkg -o build/extracted_vm_runner \
    build/thiele_core.mli build/thiele_core.ml build/extracted_vm_runner.ml
stage build/extracted_vm_runner build/extracted_vm_runner.cmi build/extracted_vm_runner.cmo \
    build/thiele_core.cmi build/thiele_core.cmo

run python3 scripts/generate_proof_dependency_dag.py
stage artifacts/proof_dependency_dag.json artifacts/proof_dependency_connectivity.json \
    artifacts/proof_dependency_file_graph.mmd artifacts/PROOF_FOUNDATION_AUDIT.md
run python3 scripts/generate_master_summary_artifacts.py --out-dir artifacts/final_claim_audit
stage artifacts/final_claim_audit/*.json

# Run unconditionally, after extraction. This also repairs missing/corrupt
# manifests and handles generator edits, new inputs, renames and deletions.
# Generator/invariant failures block the commit, with their diagnostics visible.
run python3 scripts/audit_rtl_text_transforms.py --out artifacts/rtl_text_transform_audit.json
stage artifacts/rtl_text_transform_audit.json
run python3 scripts/generate_rtl_pipeline_manifest.py --out artifacts/rtl_pipeline_manifest.json
stage artifacts/rtl_pipeline_manifest.json

# Every collected test runs, with missing backends treated as failures.
# CPU-heavy freeze simulations have a 30-second wall-clock deadline; running
# them alongside other simulator workers can exceed it on a Codespace. Match
# CI's sequential execution explicitly, without reducing coverage/timeouts.
if python3 -c 'import xdist' >/dev/null 2>&1; then
    run python3 -m pytest tests/ -q --tb=short --strict-backends -n 0
else
    run python3 -m pytest tests/ -q --tb=short --strict-backends
fi
run python3 scripts/inquisitor.py --report INQUISITOR_REPORT.md
stage INQUISITOR_REPORT.md

# Tests can rebuild extraction or modify artifacts. Do not regenerate over a
# failed freshness check or silently commit a different version than was tested.
run python3 scripts/generate_rtl_pipeline_manifest.py --check
run python3 scripts/audit_rtl_text_transforms.py --check
run python3 scripts/check_hook_worktree.py

echo "[pre-commit] PASS: commit artifacts and local verification agree."
