\ProvidesPackage{book}[2026/10/11 The Thiele Machine book composition]
\RequirePackage{needspace}
\RequirePackage{tocloft}

\geometry{paperwidth=190mm,paperheight=255mm,inner=22mm,outer=24mm,
  top=25mm,bottom=28mm,headheight=0pt,headsep=0pt,footskip=14mm}
\setstretch{1}
\makeatletter
\renewcommand\normalsize{\@setfontsize\normalsize{10.8}{14.5}%
  \abovedisplayskip 10pt plus 2pt minus 2pt
  \belowdisplayskip 10pt plus 2pt minus 2pt
  \abovedisplayshortskip 3pt plus 1pt
  \belowdisplayshortskip 7pt plus 1pt minus 1pt}
\renewcommand\small{\@setfontsize\small{9.7}{12.8}}
\renewcommand\footnotesize{\@setfontsize\footnotesize{8.8}{11.4}}
\renewcommand\scriptsize{\@setfontsize\scriptsize{8}{10.4}}
\makeatother
\normalsize
\setlength{\parindent}{1em}
\setlength{\parskip}{3pt plus .5pt minus .5pt}
\setlength{\emergencystretch}{3em}
\tolerance=1600
\hbadness=3000
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=5000
\raggedbottom
\renewcommand{\ttdefault}{lmtt}
\setlist{leftmargin=1.7em,itemsep=3pt,topsep=7pt,parsep=2pt}
\hypersetup{pdftitle={The Thiele Machine},pdfauthor={Devon Thiele},
  pdfsubject={A Computational Model with Explicit Structural Cost},
  pdfdisplaydoctitle=true,pdfpagelayout=TwoPageRight,
  colorlinks=true,allcolors=black,bookmarksdepth=3}

% The running matter stays at the edge of the reading field.
\renewcommand{\sectionmark}[1]{\markboth{#1}{#1}}
\newcommand{\BookRunning}{\sffamily\fontsize{7.5}{9}\selectfont}
\fancypagestyle{book}{%
  \fancyhf{}%
  \fancyfoot[LE]{\BookRunning\thepage\hspace{5mm}The Thiele Machine}%
  \fancyfoot[RO]{\BookRunning Devon Thiele\hspace{5mm}\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{plain}{%
  \fancyhf{}\fancyfoot[LE,RO]{\BookRunning\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{book}

% Preserve the manuscript's section flow and its own explicit page breaks.
\titleformat{\section}[display]{\normalfont\raggedright}
  {\BookRunning\thesection}{10pt}{\fontsize{24}{28}\selectfont}
\titleformat{name=\section,numberless}[display]{\normalfont\raggedright}
  {}{0pt}{\fontsize{24}{28}\selectfont}
\titlespacing*{\section}{0pt}{10mm}{8mm}
\titleformat{\subsection}{\normalfont\bfseries\fontsize{11.2}{14.5}\selectfont}
  {\thesubsection}{.7em}{}
\titlespacing*{\subsection}{0pt}{19pt plus 3pt minus 2pt}{7pt}
\titleformat{\subsubsection}{\normalfont\itshape\fontsize{10.8}{14.5}\selectfont}
  {\thesubsubsection}{.7em}{}
\titlespacing*{\subsubsection}{0pt}{14pt plus 2pt}{5pt}

% Keep the original contents entries and hierarchy.
\setlength{\cftbeforetoctitleskip}{13mm}
\setlength{\cftaftertoctitleskip}{15mm}
\renewcommand{\cfttoctitlefont}{\normalfont\fontsize{29}{33}\selectfont}
\renewcommand{\cftaftertoctitle}{\thispagestyle{plain}\markboth{Contents}{Contents}}
\setlength{\cftbeforepartskip}{16pt}
\setlength{\cftbeforesecskip}{4pt}
\renewcommand{\cftpartfont}{\normalfont\bfseries}
\renewcommand{\cftpartpagefont}{\normalfont}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsecleader}{\hfill}
\setlength{\cftsecindent}{1.7em}
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftpartnumwidth}{1.7em}

% Upright statements support sustained reading of long hypotheses.
\newtheoremstyle{thielethm}{13pt plus 2pt}{9pt plus 1pt}{\normalfont}{0pt}
  {\bfseries}{.}{.6em}{}
\newtheoremstyle{thieledef}{13pt plus 2pt}{9pt plus 1pt}{\normalfont}{0pt}
  {\bfseries}{.}{.6em}{}
\BeforeBeginEnvironment{theorem}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{lemma}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{definition}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{proposition}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{proof}{\Needspace{3\baselineskip}}
\renewenvironment{plainreading}{%
  \par\addvspace{9pt}\noindent\textit{Plain reading.}\enspace\ignorespaces
}{\par\addvspace{6pt}}

\AtBeginEnvironment{longtable}{%
  \renewcommand{\arraystretch}{1.12}\setlength{\tabcolsep}{3.5pt}}
\setlength{\LTpre}{10pt}
\setlength{\LTpost}{10pt}
\setlength{\heavyrulewidth}{.55pt}
\setlength{\lightrulewidth}{.3pt}
