% The small hand: Charter capitals, letterspaced, in ink.
\newcommand{\BookLabel}[1]{{\normalfont\fontsize{8}{10}\selectfont\textls[120]{\MakeUppercase{#1}}}}
\newcommand{\BookFolio}{{\normalfont\fontsize{9}{11}\selectfont\thepage}}
\newcommand{\BookHead}[1]{{\normalfont\itshape\fontsize{9}{11}\selectfont #1}}

% The cells. Proof size is the x-height; page size is the measure.
\newcommand{\CellStroke}{0.5pt}
\newcommand{\BlankCell}{\tikz[baseline=0pt]\draw[line width=\CellStroke] (0,0) rectangle (1.3ex,1.3ex);}
\newcommand{\FilledCell}{\tikz[baseline=0pt]\fill[flag] (0,0) rectangle (1.3ex,1.3ex);}
\newcommand{\PageCellSide}{\dimexpr\textwidth-0.7pt\relax}
\newcommand{\PageCellBlank}{\noindent\tikz\draw[line width=0.7pt] (0,0) rectangle (\PageCellSide,\PageCellSide);}
\newcommand{\PageCellFilled}{\noindent\tikz\fill[flag] (0,0) rectangle (\PageCellSide,\PageCellSide);}

% Running heads: the chapter on the left-hand page, the section on the right,
% folios at the outer edge. Opener pages carry a folio at the foot only.
\renewcommand{\sectionmark}[1]{\markboth{\thesection\hspace{0.9em}#1}{}}
\renewcommand{\subsectionmark}[1]{\markright{\thesubsection\hspace{0.9em}#1}}
\newcommand{\BookSecMark}[1]{\markboth{#1}{#1}#1}
\fancypagestyle{book}{%
  \fancyhf{}%
  \fancyhead[LE]{\BookFolio\hspace{1.6em}\BookHead{\leftmark}}%
  \fancyhead[RO]{\BookHead{\rightmark}\hspace{1.6em}\BookFolio}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{plain}{%
  \fancyhf{}\fancyfoot[C]{\BookFolio}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{book}

% The ledger of statements. Each theorem-style statement takes a number in
% order of appearance; a proof that closes on the page pays for the last one
% opened; \proofclosed marks a proof that closed inside its own statement.
% The pairing is written to the aux so the colophon can count it back.
\makeatletter
\newcounter{bookclaim}
\newcounter{bookpaid}
\providecommand{\ClaimTotal}{0}
\newcommand{\OpenClaim}{\stepcounter{bookclaim}%
  \marginnote{\BlankCell}[25pt]}
\newcommand{\PayClaim}{%
  \ifcsname book@paid@\number\value{bookclaim}\endcsname\else
    \stepcounter{bookpaid}%
    \expandafter\gdef\csname book@paid@\number\value{bookclaim}\endcsname{1}%
    \immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space bookpaid@\number\value{bookclaim}\string\endcsname{1}}%
  \fi
  \marginnote{\FilledCell}[0pt]}
\newcommand{\proofclosed}{\unskip\nobreak\hfill\PayClaim}
\AtEndDocument{\immediate\write\@auxout{\string\gdef\string\ClaimTotal{\number\value{bookclaim}}}%
  \immediate\write\@auxout{\string\gdef\string\PaidTotal{\number\value{bookpaid}}}}
\providecommand{\PaidTotal}{0}
\newcommand{\BookRecordClaim}[1]{\immediate\write\@auxout{\string\expandafter\string\gdef\string\csname\space bookclaimlabel@\number\value{bookclaim}\string\endcsname{#1 \thetheorem}}}
\AtEndEnvironment{theorem}{\BookRecordClaim{Theorem}}
\AtEndEnvironment{lemma}{\BookRecordClaim{Lemma}}
\AtEndEnvironment{corollary}{\BookRecordClaim{Corollary}}
\AtEndEnvironment{proposition}{\BookRecordClaim{Proposition}}
\AtEndEnvironment{thesis}{\BookRecordClaim{Thesis}}
\AtEndEnvironment{conjecture}{\BookRecordClaim{Conjecture}}
\newcommand{\OpenClaimList}{%
  \@tempcnta=1 \def\book@sep{}%
  \loop\ifnum\@tempcnta>\ClaimTotal\relax\else
    \ifcsname bookpaid@\number\@tempcnta\endcsname\else
      \book@sep\csname bookclaimlabel@\number\@tempcnta\endcsname\def\book@sep{, }%
    \fi
    \advance\@tempcnta 1 \repeat}
\makeatother
\newcommand{\LedgerGrid}{%
  \begin{tikzpicture}[x=3.4mm,y=3.4mm]
    \foreach \i in {1,...,\ClaimTotal}{%
      \pgfmathtruncatemacro{\c}{mod(\i-1,25)}\pgfmathtruncatemacro{\r}{int((\i-1)/25)}%
      \ifcsname bookpaid@\i\endcsname
        \fill[flag] (\c,-\r) rectangle +(0.7,0.7);
      \else
        \draw[line width=\CellStroke] (\c,-\r) rectangle +(0.7,0.7);
      \fi}
  \end{tikzpicture}}

% Parts open on the right. Each engraving has its own subject and viewpoint;
