\ProvidesPackage{book}[2026/10/18 The Thiele Machine book composition]
\RequirePackage{needspace}
\RequirePackage{tocloft}
\RequirePackage{charter}

% One page, one ink, one grey. The only ornament in the book is the open
% square: the blank cell the book is about. It closes every proof.
\definecolor{inkgrey}{gray}{0.52}
\definecolor{palegrey}{gray}{0.84}

\geometry{paperwidth=190mm,paperheight=255mm,inner=22mm,outer=30mm,
  top=27mm,bottom=28mm,headheight=14pt,headsep=9mm,footskip=12mm}
\setstretch{1}
\makeatletter
\renewcommand\normalsize{\@setfontsize\normalsize{11}{15}%
  \abovedisplayskip 10pt plus 2pt minus 2pt
  \belowdisplayskip 10pt plus 2pt minus 2pt
  \abovedisplayshortskip 3pt plus 1pt
  \belowdisplayshortskip 7pt plus 1pt minus 1pt}
\renewcommand\small{\@setfontsize\small{10}{13.4}}
\renewcommand\footnotesize{\@setfontsize\footnotesize{8.8}{11.4}}
\renewcommand\scriptsize{\@setfontsize\scriptsize{8}{10.4}}
\makeatother
\normalsize
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.5pt plus .5pt minus .5pt}
\setlength{\emergencystretch}{3em}
\tolerance=1600
\hbadness=3000
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=5000
\raggedbottom
\renewcommand{\ttdefault}{lmtt}
\setlist{leftmargin=1.7em,itemsep=3pt,topsep=7pt,parsep=2pt}
\hypersetup{pdftitle={The Thiele Machine},pdfauthor={Devon Thiele},
  pdfsubject={A Computational Model with Explicit Structural Cost},
  pdfdisplaydoctitle=true,pdfpagelayout=TwoPageRight,
  colorlinks=true,allcolors=black,bookmarksdepth=3}

% Small letterspaced labels: the running heads, the part and chapter marks.
\newcommand{\BookLabel}[1]{{\sffamily\fontsize{7.5}{9}\selectfont\textls[160]{\MakeUppercase{#1}}}}
\newcommand{\BookFolio}{{\sffamily\fontsize{8.5}{10}\selectfont\thepage}}

% Running heads: the book on the left-hand page, the chapter on the right.
\renewcommand{\sectionmark}[1]{\markboth{#1}{#1}}
\renewcommand{\subsectionmark}[1]{}
\newcommand{\BookSecMark}[1]{\markboth{#1}{#1}#1}
\fancypagestyle{book}{%
  \fancyhf{}%
  \fancyhead[LE]{\BookFolio\hspace{1.6em}\textcolor{inkgrey}{\BookLabel{The Thiele Machine}}}%
  \fancyhead[RO]{\textcolor{inkgrey}{\BookLabel{\rightmark}}\hspace{1.6em}\BookFolio}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{plain}{%
  \fancyhf{}\fancyfoot[C]{\BookFolio}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\pagestyle{book}

% A part gets a page of its own: its numeral large and pale, its title over it,
% and the few paragraphs that introduce it. Its first chapter starts overleaf.
\titleformat{\part}[display]{\normalfont\raggedright}
  {\fontsize{150}{150}\selectfont\color{palegrey}\thepart}{-34pt}
  {\fontsize{36}{40}\selectfont\bfseries}
\titlespacing*{\part}{0pt}{22mm}{18mm}
\pretocmd{\part}{\clearpage\thispagestyle{plain}}{}{}

% Every chapter opens its own page, a third of the way down, with its number
% standing large and grey beside the title.
\titleformat{\section}[display]{\normalfont\raggedright}
  {\fontsize{72}{72}\selectfont\color{inkgrey}\thesection}{14pt}
  {\fontsize{27}{31}\selectfont\bfseries}
\titleformat{name=\section,numberless}[display]{\normalfont\raggedright}
  {}{0pt}{\fontsize{27}{31}\selectfont\bfseries\BookSecMark}
\titlespacing*{\section}{0pt}{38mm}{16mm}
\pretocmd{\section}{\clearpage\thispagestyle{plain}\phantomsection}{}{}
\titleformat{\subsection}{\normalfont\bfseries\fontsize{12}{15}\selectfont}
  {\textcolor{inkgrey}{\thesubsection}}{.8em}{}
\titlespacing*{\subsection}{0pt}{20pt plus 3pt minus 2pt}{7pt}
\titleformat{\subsubsection}{\normalfont\itshape\fontsize{11}{15}\selectfont}
  {\textcolor{inkgrey}{\thesubsubsection}}{.8em}{}
\titlespacing*{\subsubsection}{0pt}{14pt plus 2pt}{5pt}

% Contents, in the same hand as the chapter openers.
\setlength{\cftbeforetoctitleskip}{38mm}
\setlength{\cftaftertoctitleskip}{16mm}
\renewcommand{\cfttoctitlefont}{\normalfont\bfseries\fontsize{27}{31}\selectfont}
\renewcommand{\cftaftertoctitle}{\thispagestyle{plain}\markboth{Contents}{Contents}}
\setlength{\cftbeforepartskip}{18pt}
\setlength{\cftbeforesecskip}{5pt}
\renewcommand{\cftpartfont}{\normalfont\bfseries}
\renewcommand{\cftpartpagefont}{\normalfont\bfseries}
\renewcommand{\cftsecfont}{\normalfont\bfseries}
\renewcommand{\cftsecpagefont}{\normalfont}
\renewcommand{\cftsubsecfont}{\normalfont}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftsubsecleader}{\hfill}
\setlength{\cftsecindent}{0pt}
\setlength{\cftsubsecindent}{1.7em}
\setlength{\cftsecnumwidth}{2.5em}
\setlength{\cftsubsecnumwidth}{3em}
\setlength{\cftpartnumwidth}{1.7em}

% Upright statements support sustained reading of long hypotheses. Each one
% is closed by the open square, the blank cell.
\newtheoremstyle{thielethm}{13pt plus 2pt}{9pt plus 1pt}{\normalfont}{0pt}
  {\bfseries}{.}{.6em}{}
\newtheoremstyle{thieledef}{13pt plus 2pt}{9pt plus 1pt}{\normalfont}{0pt}
  {\bfseries}{.}{.6em}{}
\renewcommand{\qedsymbol}{\raisebox{0.1ex}{\tikz\draw[line width=0.45pt] (0,0) rectangle (1.35ex,1.35ex);}}
\BeforeBeginEnvironment{theorem}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{lemma}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{definition}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{proposition}{\Needspace{5\baselineskip}}
\BeforeBeginEnvironment{proof}{\Needspace{3\baselineskip}}
\renewenvironment{plainreading}{%
  \par\addvspace{9pt}\noindent\textit{Plain reading.}\enspace\ignorespaces
}{\par\addvspace{6pt}}

\AtBeginEnvironment{longtable}{%
  \fontsize{9}{12.4}\selectfont%
  \renewcommand{\arraystretch}{1.12}\setlength{\tabcolsep}{3.5pt}}
\setlength{\LTpre}{10pt}
\setlength{\LTpost}{10pt}
\setlength{\heavyrulewidth}{.55pt}
\setlength{\lightrulewidth}{.3pt}
\colorlet{linkblue}{black}
